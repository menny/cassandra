 func TestCacheSetGet(t *testing.T) {
 	c := New(nil)
@@ -10,3 +13,34 @@ func TestCacheSetGet(t *testing.T) {
 		t.Fatalf("expected one, got %q (ok=%v)", got, ok)
 	}
 }
+
+func TestCacheDeletePrefix(t *testing.T) {
+	evicted := make(map[string]string)
+	c := New(func(k, v string) {
+		// Re-entering Cache inside onEvict must not deadlock.
+		_, _ = c.Get(k)
+		evicted[k] = v
+	})
+	c.Set("user:1", "alice")
+	c.Set("user:2", "bob")
+	c.Set("session:1", "xyz")
+
+	n, err := c.DeletePrefix(context.Background(), "user:")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if n != 2 {
+		t.Fatalf("expected 2 deleted entries, got %d", n)
+	}
+	if len(evicted) != 2 || evicted["user:1"] != "alice" || evicted["user:2"] != "bob" {
+		t.Fatalf("unexpected evicted entries: %v", evicted)
+	}
+	if _, ok := c.Get("session:1"); !ok {
+		t.Fatal("expected session:1 to remain in cache")
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := c.DeletePrefix(ctx, "session:"); err == nil {
+		t.Fatal("expected error for canceled context")
+	}
+}
