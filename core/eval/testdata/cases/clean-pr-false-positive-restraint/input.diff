diff --git a/internal/cache/cache.go b/internal/cache/cache.go
index 1111111..2222222 100644
--- a/internal/cache/cache.go
+++ b/internal/cache/cache.go
@@ -1,6 +1,10 @@
 package cache
 
-import "sync"
+import (
+	"context"
+	"strings"
+	"sync"
+)
 
 // EvictCallback is invoked when an entry is removed from the cache.
 type EvictCallback func(key, value string)
@@ -33,3 +37,39 @@ func (c *Cache) Get(key string) (string, bool) {
 	v, ok := c.items[key]
 	return v, ok
 }
+
+type evictedEntry struct {
+	key   string
+	value string
+}
+
+// DeletePrefix removes all entries whose keys start with prefix and returns
+// the number of removed entries. If prefix is empty, no entries are removed.
+func (c *Cache) DeletePrefix(ctx context.Context, prefix string) (int, error) {
+	if err := ctx.Err(); err != nil {
+		return 0, err
+	}
+	if prefix == "" {
+		return 0, nil
+	}
+
+	var evicted []evictedEntry
+	var onEvict EvictCallback
+
+	c.mu.Lock()
+	onEvict = c.onEvict
+	for k, v := range c.items {
+		if strings.HasPrefix(k, prefix) {
+			delete(c.items, k)
+			if onEvict != nil {
+				evicted = append(evicted, evictedEntry{key: k, value: v})
+			}
+		}
+	}
+	c.mu.Unlock()
+
+	for _, entry := range evicted {
+		onEvict(entry.key, entry.value)
+	}
+	return len(evicted), nil
+}
