load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "ai_reviewer_lib",
    srcs = ["main.go"],
    importpath = "github.com/menny/cassandra/cmd/ai_reviewer",
    visibility = ["//visibility:private"],
    deps = [
        "//core",
        "//core/config",
        "//core/prompts",
        "//llm",
        "//tools",
        "//util",
        "@com_github_spf13_pflag//:pflag",
        "@com_github_spf13_viper//:viper",
    ],
)

# pure and static ensure the binary is compiled without Cgo/libc dependencies,
# producing a fully statically linked executable for easy distribution across Linux environments.
go_binary(
    name = "ai_reviewer",
    basename = "cassandra",  # keep
    embed = [":ai_reviewer_lib"],
    pure = "on",  # keep
    static = "on",  # keep
    visibility = ["//visibility:public"],
)

go_test(
    name = "ai_reviewer_test",
    srcs = ["main_test.go"],
    embed = [":ai_reviewer_lib"],
    deps = [
        "//core",
        "//core/config",
        "@com_github_spf13_pflag//:pflag",
        "@com_github_spf13_viper//:viper",
        "@com_github_stretchr_testify//require",
    ],
)
